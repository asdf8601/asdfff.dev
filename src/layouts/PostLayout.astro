---
import BaseLayout from "./BaseLayout.astro"
import PageSearchModal from "../components/PageSearchModal.astro"

const { frontmatter } = Astro.props
const title = frontmatter?.title || "Untitled"
const description = frontmatter?.description
---

<BaseLayout title={`${title} - wtfm`} description={description}>
  <article>
    <h1>{title}</h1>
    {
      frontmatter?.date && (
        <time class="post-date" datetime={frontmatter.date}>
          {new Date(frontmatter.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      )
    }
    <slot />
  </article>

  <script is:inline>
    if (document.querySelector("pre.mermaid")) {
      const s = document.createElement("script")
      s.src = "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"
      const diagrams = Array.from(document.querySelectorAll("pre.mermaid"))
      diagrams.forEach(pre => {
        pre.dataset.source = pre.textContent
      })
      const render = () => {
        const isDark = document.documentElement.getAttribute("data-theme") === "dark"
        const palette = isDark
          ? {
              background: "#262523",
              primaryColor: "#2c2b28",
              primaryTextColor: "#e6e1d8",
              primaryBorderColor: "#4a4843",
              lineColor: "#a39e94",
              secondaryColor: "#33322f",
              tertiaryColor: "#1e1d1b",
              mainBkg: "#2c2b28",
              nodeBorder: "#4a4843",
              clusterBkg: "#1e1d1b",
              clusterBorder: "#4a4843",
              titleColor: "#e6e1d8",
              edgeLabelBackground: "#262523",
              textColor: "#e6e1d8",
            }
          : {
              background: "#f3f0e9",
              primaryColor: "#faf8f3",
              primaryTextColor: "#2b2a27",
              primaryBorderColor: "#cfc9bc",
              lineColor: "#6f6b63",
              secondaryColor: "#f1ede4",
              tertiaryColor: "#faf8f3",
              mainBkg: "#faf8f3",
              nodeBorder: "#cfc9bc",
              clusterBkg: "#f1ede4",
              clusterBorder: "#cfc9bc",
              titleColor: "#2b2a27",
              edgeLabelBackground: "#f3f0e9",
              textColor: "#2b2a27",
            }
        mermaid.initialize({
          startOnLoad: false,
          theme: "base",
          themeVariables: palette,
        })
        diagrams.forEach(pre => {
          pre.removeAttribute("data-processed")
          pre.textContent = pre.dataset.source
        })
        mermaid.run({ nodes: diagrams }).catch(err => console.error("mermaid:", err))
      }
      s.onload = () => {
        render()
        new MutationObserver(render).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        })
      }
      document.head.appendChild(s)
    }
  </script>

  <PageSearchModal />
</BaseLayout>

<style>
  article {
    max-width: 100%;
  }

  article h1 {
    margin-bottom: var(--spacing-sm);
  }

  .post-date {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-bottom: var(--spacing-xl);
  }
</style>

<script>
  let gCount = 0
  let gTimer: number | undefined
  let escapeCount = 0
  let escapeTimer: number | undefined

  document.addEventListener("keydown", e => {
    const handlers = (window as any).pageSearchHandlers
    if (handlers?.isPageSearchActive()) {
      if (e.key === "Escape") {
        e.preventDefault()
        e.stopImmediatePropagation()
        handlers.closePageSearch()
      }
      return
    }

    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return

    if (e.key === "/" && !e.ctrlKey && !e.metaKey) {
      e.preventDefault()
      handlers?.openPageSearch()
    } else if (e.key === "j") {
      e.preventDefault()
      window.scrollBy({ top: 100, behavior: "smooth" })
    } else if (e.key === "k" && !(e.ctrlKey || e.metaKey)) {
      e.preventDefault()
      window.scrollBy({ top: -100, behavior: "smooth" })
    } else if (e.key === "g") {
      gCount++
      if (gCount === 1) {
        gTimer = window.setTimeout(() => {
          gCount = 0
        }, 500)
      } else if (gCount === 2) {
        e.preventDefault()
        if (gTimer) clearTimeout(gTimer)
        window.scrollTo({ top: 0, behavior: "smooth" })
        gCount = 0
      }
    } else if (e.key === "G") {
      e.preventDefault()
      window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" })
    } else if (e.key === "Escape") {
      escapeCount++
      if (escapeCount === 1) {
        escapeTimer = window.setTimeout(() => {
          escapeCount = 0
        }, 500)
      } else if (escapeCount === 2) {
        if (escapeTimer) clearTimeout(escapeTimer)
        window.location.href = "/posts"
      }
    }
  })
</script>

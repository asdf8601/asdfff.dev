---
import BaseLayout from "../layouts/BaseLayout.astro"
import PageSearchModal from "../components/PageSearchModal.astro"

const tilModules = import.meta.glob("../content/til/*.md", { eager: true })

const sortedTils = Object.entries(tilModules)
  .sort(([pathA, a], [pathB, b]) => {
    const byDate =
      new Date(b.frontmatter.date || 0).getTime() - new Date(a.frontmatter.date || 0).getTime()
    return byDate || pathA.localeCompare(pathB)
  })
  .map(([, til]) => til)
---

<BaseLayout title="til - wtfm">
  <article>
    <h1>til</h1>

    <p class="lead">Today I learned.</p>

    {
      sortedTils.length > 0 ? (
        <div class="tl-list">
          {sortedTils.map((til, index) => {
            const tilNumber = sortedTils.length - index
            const date = new Date(til.frontmatter.date)
            const dateKey = date.toISOString().slice(0, 10)
            const formattedDate = date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
            return (
              <section class="tl-entry" id={`til-${tilNumber}`}>
                <div class="tl-meta">
                  <time datetime={dateKey}>{formattedDate}</time>
                  <a
                    href={`#til-${tilNumber}`}
                    class="tl-number"
                    aria-label={`Link to TIL #${tilNumber}`}
                  >
                    #{tilNumber}
                  </a>
                </div>
                {til.frontmatter.title && <h2 class="tl-title">{til.frontmatter.title}</h2>}
                <div class="tl-content">
                  <til.Content />
                </div>
              </section>
            )
          })}
        </div>
      ) : (
        <p class="empty-state">No TILs yet. Add markdown files to src/content/til/</p>
      )
    }
  </article>

  <PageSearchModal />
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--spacing-md);
  }

  .lead {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xl);
  }

  .tl-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
  }

  .tl-entry {
    scroll-margin-top: var(--spacing-xl);
    padding-left: var(--spacing-md);
    margin-left: calc(var(--spacing-md) * -1);
  }

  .tl-meta {
    display: flex;
    gap: var(--spacing-sm);
    align-items: baseline;
    margin-bottom: var(--spacing-xs);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .tl-number {
    color: var(--color-text-muted);
  }

  .tl-entry:target {
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  .tl-entry:target .tl-number,
  .tl-entry.selected-item .tl-number {
    color: var(--color-accent);
  }

  .tl-title {
    margin: 0 0 var(--spacing-sm) 0;
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .tl-content :global(p) {
    margin-bottom: 0;
  }

  .tl-content :global(p + p) {
    margin-top: var(--spacing-sm);
  }

  .tl-content :global(ul) {
    margin-bottom: 0;
  }
</style>

<script>
  const { openPageSearch, isPageSearchActive } = (window as any).pageSearchHandlers

  document.addEventListener("DOMContentLoaded", () => {
    const tilEntries = Array.from(document.querySelectorAll(".tl-entry"))
    let selectedIndex = -1

    function selectItem(index: number) {
      tilEntries.forEach(entry => entry.classList.remove("selected-item"))
      if (index >= 0 && index < tilEntries.length) {
        selectedIndex = index
        tilEntries[selectedIndex].classList.add("selected-item")
        tilEntries[selectedIndex].scrollIntoView({ behavior: "smooth", block: "center" })
      }
    }

    document.addEventListener("keydown", e => {
      const target = e.target as HTMLElement

      if (isPageSearchActive()) {
        return
      }

      if (target.tagName === "INPUT" || target.tagName === "TEXTAREA") {
        return
      }

      if (e.key === "k" && (e.ctrlKey || e.metaKey)) {
        return
      }

      if (e.key === "/") {
        e.preventDefault()
        openPageSearch()
        return
      }

      if (e.key === "j") {
        e.preventDefault()
        selectItem(selectedIndex + 1)
      } else if (e.key === "k") {
        e.preventDefault()
        if (selectedIndex > 0) {
          selectItem(selectedIndex - 1)
        }
      } else if (e.key === "Enter" && selectedIndex >= 0) {
        e.preventDefault()
        const link = tilEntries[selectedIndex].querySelector(".tl-number") as HTMLAnchorElement
        if (link) {
          link.click()
        }
      }
    })
  })
</script>

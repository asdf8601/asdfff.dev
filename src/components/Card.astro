---
interface Props {
  title?: string
  type?: "default" | "info" | "warning" | "success" | "error"
}

const { title, type = "default" } = Astro.props
---

<div class={`card card-${type}`}>
  {title && <div class="card-title">{title}</div>}
  <div class="card-content">
    <slot />
  </div>
</div>

<style>
  .card {
    --card-color: var(--color-text-muted);

    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: var(--color-bg-secondary);
    border-left: 2px solid var(--card-color);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .card-title {
    color: var(--card-color);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    margin-bottom: var(--spacing-xs);
    text-transform: uppercase;
  }

  .card-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .card-content :global(ul),
  .card-content :global(ol) {
    margin-left: var(--spacing-md);
    padding-left: 0;
  }

  .card-content :global(ul li),
  .card-content :global(ol li) {
    margin-bottom: var(--spacing-xs);
  }

  .card-info {
    --card-color: #4a6f8a;
  }

  .card-warning {
    --card-color: #725a1e;
  }

  .card-success {
    --card-color: #4d673a;
  }

  .card-error {
    --card-color: #b5432f;
  }

  :global([data-theme="dark"]) .card-info {
    --card-color: #8fb4cf;
  }

  :global([data-theme="dark"]) .card-warning {
    --card-color: #d3b273;
  }

  :global([data-theme="dark"]) .card-success {
    --card-color: #a7bf8e;
  }

  :global([data-theme="dark"]) .card-error {
    --card-color: #e08a74;
  }
</style>

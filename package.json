{
  "name": "asdfff.dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node generate-search-data.js && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "clean": "rm -rf node_modules/.vite dist .astro",
    "lint": "eslint . && stylelint '**/*.{css,astro}' && prettier --check .",
    "lint:fix": "eslint --fix . && stylelint --fix '**/*.{css,astro}' && prettier --write .",
    "commitlint": "commitlint --edit",
    "validate": "bun run lint && bun run build"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "astro": "^5.18.2",
    "astro-expressive-code": "^0.42.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "svgo": "^4.1.0"
  }
}
